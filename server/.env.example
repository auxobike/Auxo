PORT=3001
SESSION_SECRET=your_session_secret_here

# Strava OAuth — get these at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REDIRECT_URI=http://localhost:3001/auth/strava/callback

# Frontend URL (for CORS and post-auth redirect)
CLIENT_URL=http://localhost:5173

# Admin API key — used to protect POST /api/admin/shops/featured
# Set to a long random string in production
ADMIN_API_KEY=your_admin_api_key_here
